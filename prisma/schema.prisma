generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String     @id @default(uuid())
  name          String
  parentId      String?
  userId        String?    // null = system content (admin-created), non-null = user-created
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")
  questions     Question[]

  @@index([userId])
}

model Question {
  id            String   @id @default(uuid())
  question      String
  options       String[]
  correctAnswer String
  difficulty    String
  type          String   @default("multiple_choice")
  shownCount    Int      @default(0)
  categoryId    String
  userId        String?  // null = system content (admin-created), non-null = user-created
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl      String?

  @@index([userId])
  @@index([categoryId])
}

model Favorite {
  id         String @id @default(uuid())
  userId     String
  categoryId String

  @@unique([userId, categoryId])
  @@index([userId])
}

